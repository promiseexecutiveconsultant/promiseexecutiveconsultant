<script>
(function(){
  var h=document.querySelector('header');
  function onScroll(){h.classList.toggle('scrolled',window.scrollY>40)}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  var b=document.getElementById('burger'),m=document.getElementById('menu');
  function toggle(open){b.classList.toggle('open',open);m.classList.toggle('open',open);b.setAttribute('aria-expanded',open)}
  b.addEventListener('click',function(){toggle(!m.classList.contains('open'))});
  m.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){toggle(false)})});

  var els=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12,rootMargin:'0px 0px -40px 0px'});
    els.forEach(function(el){io.observe(el)});
  }else{els.forEach(function(el){el.classList.add('in')})}

  document.getElementById('yr').textContent=new Date().getFullYear();

  var f=document.getElementById('enquiry'),st=document.getElementById('status'),btn=document.getElementById('sendBtn');
  function show(msg,err){st.textContent=msg;st.className='status show'+(err?' err':'')}
  f.addEventListener('submit',function(e){
    e.preventDefault();
    if(!f.checkValidity()){f.reportValidity();return}
    if(f.querySelector('[name=_honey]').value){return}
    btn.disabled=true;btn.style.opacity=.6;
    fetch('https://formsubmit.co/ajax/headhunter.search.cosultant@gmail.com',{
      method:'POST',headers:{'Accept':'application/json'},body:new FormData(f)
    }).then(function(r){return r.json()}).then(function(d){
      if(d.success==='true'||d.success===true){f.reset();show('Thank you. Your enquiry has been received and will be answered personally by email.')}
      else{throw new Error('fail')}
    }).catch(function(){
      show('Your message could not be sent. Please email promise@executivesearch.com directly.',true)
    }).finally(function(){btn.disabled=false;btn.style.opacity=1});
  });
})();
</script>
